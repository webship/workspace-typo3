{
  "name": "@webship.co/workspace-typo3",
  "version": "1.0.7",
  "description": "TYPO3 for Webship Workspace: the builder (`cmd-typo3-project.sh`) and the typo3 console tool in every sites folder, the default accounts, the TYPO3 step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-typo3.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "docs",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "typo3",
    "label": "TYPO3",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-typo3-project.sh",
        "commands/cmd-tools-typo3-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-typo3.sh"
      ],
      "args": [
        "scripts/args/arg-typo3.sh",
        "scripts/args/arg-typo3-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/typo3-site-builder.md",
        "ai/agents/typo3-tester.md"
      ],
      "skills": [
        "ai/skills/typo3-scenarios"
      ],
      "commands": [
        "ai/commands/typo3-test.md"
      ],
      "prompts": [
        "ai/prompts/typo3-build-and-test.md"
      ]
    },
    "features": [
      "features/typo3.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
